# Subindo a base tratada e as bibliotecas

import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

df = pd.read_csv('/content/sample_data/base_vendas_tratada.csv')

# Faturamento Total

faturamento_total = df['Valor_Compra'].sum()

print('Faturamento Total:')
print(round(faturamento_total, 2))

# Ticket Médio

ticket_medio = df['Valor_Compra'].mean()

print('Ticket Médio:')
print(round(ticket_medio, 2))

# Clientes Únicos

clientes = df['ID_Cliente'].nunique()

print('Clientes únicos:')
print(clientes)

# Avaliação Média

avaliacao_media = df['Avaliacao'].mean()

print('Avaliação média:')
print(round(avaliacao_media,2))

# Faturamento por Categoria de produto

plt.figure(figsize=(10,5))

ordem = df.groupby('Categoria_Produto')['Valor_Compra'].sum().sort_values(ascending=True).index

sns.barplot(
    data=df,
    x='Categoria_Produto',
    y='Valor_Compra',
    estimator=sum,
    order=ordem
)

plt.title('Faturamento por Categoria')
plt.xlabel('Categoria')
plt.ylabel('Valor de Compra')

plt.show()

# Compras realizadas por cidade

plt.figure(figsize=(10,5))

ordem = df['Estado'].value_counts().sort_values().index

sns.countplot(
    data=df,
    x='Estado',
    order=ordem
)

plt.title('Quantidade de Compras por estado')
plt.xlabel('Estados')
plt.ylabel('Quantidade')

plt.show()

# Gráfico de evolução

df["Data_Compra"] = pd.to_datetime(df["Data_Compra"])

df["Mes"] = df["Data_Compra"].dt.to_period("M")

vendas_mes = df.groupby("Mes")["Valor_Compra"].sum()

plt.figure(figsize=(12,5))

vendas_mes.plot()

plt.title("Evolução Mensal das Vendas")
plt.xlabel("Mês")
plt.ylabel("Faturamento")

plt.show()

